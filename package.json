{
  "name": "dsh-anime-bundle",
  "version": "1.0.2",
  "type": "module",
  "description": "二次元大肥鱼模式：一键开关整套二次元外观插件、检查更新、装回缺失的插件，并带一个可随时开关的「肥鱼娘」人格。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-harness-desktop",
    "theme",
    "persona",
    "anime"
  ],
  "license": "MIT",
  "author": "吴靖文",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CEQ233/dsh-anime-bundle.git"
  },
  "homepage": "https://github.com/CEQ233/dsh-anime-bundle#readme",
  "bugs": {
    "url": "https://github.com/CEQ233/dsh-anime-bundle/issues"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./persona": "./persona.js",
    "./catalog": "./catalog.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "persona.js",
    "catalog.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md"
  ],
  "icon": "./icon.svg",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
